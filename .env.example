PORT=3000
HOST=0.0.0.0
# Public prefix, without /app; empty means domain root.
APP_ROOT_PATH=/forge
# Fixed upstream, optionally including its own deployment prefix.
BACKEND_URL=http://127.0.0.1:4444
# Set true behind HTTPS nginx. Never enable for plain HTTP development.
COOKIE_SECURE=false
# Public origin for reverse-proxy redirects. Required behind nginx in production.
PUBLIC_ORIGIN=http://localhost:3000
# Only trust X-Forwarded-For from these immediate proxy networks. Empty = direct clients.
TRUSTED_PROXY_CIDRS=
# debug, info (default), warn, error or silent. Restart after changing.
# info includes access logs; warn hides successful requests; errors remain at error.
LOG_LEVEL=info
